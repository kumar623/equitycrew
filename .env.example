# Copy to .env and fill in. Never commit .env.

# Required — the only key the app needs.
ANTHROPIC_API_KEY=your_claude_api_key_here

# ---- Optional knobs (all have working defaults) ----

# Per-agent model routing. Defaults: financials/news on claude-haiku-4-5,
# risk/writer/critic/verifier on claude-sonnet-5.
# EQUITYCREW_MODEL_FINANCIALS=claude-haiku-4-5
# EQUITYCREW_MODEL_NEWS=claude-haiku-4-5
# EQUITYCREW_MODEL_RISK=claude-sonnet-5
# EQUITYCREW_MODEL_WRITER=claude-sonnet-5
# EQUITYCREW_MODEL_CRITIC=claude-sonnet-5
# EQUITYCREW_MODEL_VERIFIER=claude-sonnet-5

# Public-demo spend limits (see src/limits.py and GET /limits).
# EQUITYCREW_IP_LIMIT=5          # billed runs per IP per hour
# EQUITYCREW_DAILY_LIMIT=60      # billed runs per day, across all visitors
# EQUITYCREW_CACHE_TTL=900       # seconds a result is replayed for free

# Skip loading the embedding model on a memory-constrained host; the Risk
# agent then reasons over live fundamentals instead of citing the 10-K.
# EQUITYCREW_DISABLE_RAG=1
